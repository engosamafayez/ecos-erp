# PHPStan — ECOS platform-wide static analysis (PROGRAM-D).
#
# Two configurations, because one level cannot serve both goals without
# weakening one of them:
#
#   phpstan.neon.dist        level 0, ENTIRE platform (Modules + app)  ← this file
#   phpstan-core.neon.dist   level 6, app/Core + Contracts + Traits
#
# Run both for full analysis:
#   php vendor/bin/phpstan analyse --memory-limit=4G
#   php vendor/bin/phpstan analyse --memory-limit=2G -c phpstan-core.neon.dist
#
# ── Why level 0 platform-wide ────────────────────────────────────────────────
# Measured 2026-08-03 against 4,153 files (Modules + app):
#
#   level 0 ->    145 errors   (0.035 / file)   ← adopted
#   level 2 -> ~6,400 errors   (extrapolated: 371 errors / 240 files, Commerce)
#   level 5 -> ~7,400 errors   (extrapolated: 430 errors / 240 files, Commerce)
#
# Level 0 already catches what breaks production: unknown classes, unknown
# functions and methods on known types, wrong argument counts, always-undefined
# variables. It reaches that with a baseline small enough to burn down rather
# than live with — the difference between a gate that works and one that gets
# bypassed.
#
# The jump from level 0 to 2 is ~44x. Most of it is Eloquent's magic
# static/dynamic surface, which Larastan resolves properly rather than
# suppresses. Raising the level before installing Larastan would manufacture
# thousands of false positives and force exactly the mass-suppression this
# program forbids.
#
# ── Ratchet policy ───────────────────────────────────────────────────────────
# The baseline freezes existing debt; NEW violations fail. It may only shrink.
# Never regenerate it wholesale to absorb new errors — fix the code, or justify
# each entry individually.
#
# Raising the level is per-module and evidence-led:
#   1. Install Larastan, re-measure the module at the target level
#   2. If the residue is burnable, fix it and pin that module higher
#   3. Record the new level here with the measurement that justified it
#
# ── Memory ───────────────────────────────────────────────────────────────────
# The default 128M limit crashes PHPStan's parallel workers on this codebase
# ("Child process error: reached configured PHP memory limit"). The full
# platform scan needs --memory-limit=4G; the core scan needs 2G.
includes:
    - phpstan-baseline-platform.neon

parameters:
    level: 0

    paths:
        - Modules
        - app

    excludePaths:
        - bootstrap/cache
        - storage
        - vendor

    tmpDir: storage/framework/cache/phpstan

    treatPhpDocTypesAsCertain: false

    # NOTE: no `ignoreErrors` here. The `trait.unused` ignore lives only in
    # phpstan-core.neon.dist, where that rule actually fires — at level 0 it is
    # never reported, and PHPStan (correctly) treats an unmatched ignore as an
    # error. Every suppression must be matched by a real finding.
