# =============================================================================
# ECOS ERP — PRODUCTION environment template          (TASK-DEVOPS-001)
#
# Target branch : main
# Deployed by   : .github/workflows/deploy.yml  (push to main)
# Compose file  : docker-compose.yml
#
# This template DOCUMENTS the Production contract. It does not change any
# running Production configuration — the live backend/.env on the Production
# server is untouched by this task.
#
# Copy to backend/.env on the Production server and fill every value marked
# CHANGE-ME. This file contains NO secrets and is safe to commit.
#
# Every value that names a database, cache, queue, session store, log or
# bucket MUST differ from its Staging counterpart. See .env.staging.example.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="ECOS ERP"
APP_ENV=production                    # Enables production optimisations
APP_KEY=                              # CHANGE-ME: php artisan key:generate
APP_DEBUG=false                       # MUST be false — never expose stack traces
APP_URL=https://erp.example.com       # CHANGE-ME: production hostname only
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error                       # Staging uses 'debug'

# ── Database ── isolated instance (ecos-mysql), isolated volume ──────────────
DB_CONNECTION=mysql
DB_HOST=mysql                         # service name on ecos-network
DB_PORT=3306
DB_DATABASE=ecos_erp                  # MUST differ from Staging
DB_USERNAME=ecos                      # CHANGE-ME
DB_PASSWORD=                          # CHANGE-ME

# ── Session ──────────────────────────────────────────────────────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=erp.example.com        # CHANGE-ME — must NOT be the Staging domain
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=ecos_session           # distinct from ecos_staging_session

# ── Cache / Queue / Redis ────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=ecos_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis                      # service name on ecos-network
REDIS_PASSWORD=                       # CHANGE-ME — set a password in Production
REDIS_PORT=6379
REDIS_DB=0                            # Staging uses 1
REDIS_CACHE_DB=2                      # Staging uses 3
REDIS_QUEUE=ecos_queue

BROADCAST_CONNECTION=log

# ── Filesystem ───────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local

# ── Mail ── real MTA; replace the compose mailpit sink before go-live ────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=                            # CHANGE-ME: real SMTP host
MAIL_PORT=465
MAIL_USERNAME=                        # CHANGE-ME
MAIL_PASSWORD=                        # CHANGE-ME
MAIL_FROM_ADDRESS="noreply@example.com"   # CHANGE-ME
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / object storage ─────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=                    # CHANGE-ME if FILESYSTEM_DISK=s3
AWS_SECRET_ACCESS_KEY=                # CHANGE-ME if FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ecos-erp-production        # MUST differ from Staging
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── HTTP ─────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=erp.example.com   # CHANGE-ME
TRUSTED_PROXIES=*

# ── Frontend build-time ──────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Deployment ───────────────────────────────────────────────────────────────
# Production migrations are run deliberately, never implicitly on container
# start. Schema changes must already have been exercised on Staging.
MIGRATE_ON_START=false
