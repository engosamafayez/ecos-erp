# =============================================================================
# ECOS ERP — STAGING environment template            (TASK-DEVOPS-001)
#
# Target branch : develop
# Deployed by   : .github/workflows/deploy.yml  (push to develop)
# Compose file  : docker-compose.staging.yml
#
# Copy to backend/.env.staging on the staging server and fill every value
# marked CHANGE-ME. This file contains NO secrets and is safe to commit.
#
# Staging shares NOTHING with Production except the Git repository. Every
# value below that names a database, cache, queue, session store, log or
# bucket is deliberately distinct from its Production counterpart.
# =============================================================================

# ── Application ──────────────────────────────────────────────────────────────
APP_NAME="ECOS ERP (Staging)"
APP_ENV=staging                       # NEVER 'production' — gates debug tooling
APP_KEY=                              # CHANGE-ME: php artisan key:generate
APP_DEBUG=true                        # Staging may show stack traces
APP_URL=https://staging.example.com   # CHANGE-ME: staging hostname only
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US
APP_MAINTENANCE_DRIVER=file
PHP_CLI_SERVER_WORKERS=4
BCRYPT_ROUNDS=12

# ── Logging ── isolated log channel; never writes to a Production sink ───────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug                       # Production uses 'error'

# ── Database ── isolated instance (ecos-staging-mysql), isolated volume ──────
DB_CONNECTION=mysql
DB_HOST=mysql                         # service name on ecos-staging-network
DB_PORT=3306
DB_DATABASE=ecos_erp_staging          # MUST differ from Production
DB_USERNAME=ecos_staging              # CHANGE-ME
DB_PASSWORD=                          # CHANGE-ME

# Consumed by docker-compose.staging.yml to provision the container.
STAGING_DB_ROOT_PASSWORD=             # CHANGE-ME
STAGING_DB_DATABASE=ecos_erp_staging
STAGING_DB_USERNAME=ecos_staging
STAGING_DB_PASSWORD=                  # CHANGE-ME (match DB_PASSWORD)

# ── Session ── isolated store; distinct cookie so a browser cannot carry a
#               Production session into Staging or vice versa ────────────────
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=staging.example.com    # CHANGE-ME — must NOT be the Production domain
SESSION_SECURE_COOKIE=true
SESSION_COOKIE=ecos_staging_session   # distinct cookie name

# ── Cache / Queue / Redis ── isolated instance AND separate DB indices ───────
# Index separation is defence in depth: even if REDIS_HOST were misconfigured
# to point at Production, cache/queue/session keyspaces would not collide.
CACHE_STORE=redis
CACHE_PREFIX=ecos_staging_cache
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis                      # service name on ecos-staging-network
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=1                            # Production uses 0
REDIS_CACHE_DB=3                      # Production uses 2
REDIS_QUEUE=ecos_staging_queue        # distinct queue name

BROADCAST_CONNECTION=log

# ── Filesystem ── isolated storage volume (staging-app-storage) ──────────────
FILESYSTEM_DISK=local

# ── Mail ── Staging must NEVER deliver to real recipients ────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=mailpit                     # SMTP sink on the staging network
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="staging@example.com"   # CHANGE-ME
MAIL_FROM_NAME="${APP_NAME}"

# ── AWS / object storage ── separate bucket if used ──────────────────────────
AWS_ACCESS_KEY_ID=                    # CHANGE-ME if FILESYSTEM_DISK=s3
AWS_SECRET_ACCESS_KEY=                # CHANGE-ME if FILESYSTEM_DISK=s3
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=ecos-erp-staging           # MUST differ from Production
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── HTTP ─────────────────────────────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=staging.example.com   # CHANGE-ME
TRUSTED_PROXIES=*

# ── Frontend build-time ──────────────────────────────────────────────────────
VITE_APP_NAME="${APP_NAME}"

# ── Deployment ───────────────────────────────────────────────────────────────
# Staging migrates automatically on deploy so schema drift surfaces here first.
MIGRATE_ON_START=true
