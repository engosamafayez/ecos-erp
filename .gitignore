# ===== ECOS ERP — repository ignores =====

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
.nova/
.zed/
.claude/

# Logs
*.log

# Environment
.env
.env.backup
.env.production
backend/.env

# Docker Compose developer override — never committed; copy from .example to use.
# Production servers must never have this file (deploy.sh aborts if it exists).
docker-compose.override.yml

# PHP / Laravel (backend)
backend/vendor/
backend/node_modules/
backend/public/build/
backend/public/hot
backend/public/storage
backend/public/app/
backend/storage/*.key
backend/storage/pail
backend/.phpunit.result.cache
backend/.phpunit.cache/
backend/auth.json
backend/_ide_helper.php

# Frontend (React / Vite)
frontend/node_modules/
frontend/dist/
frontend/*.local

# Node (root, if any)
/node_modules/

# Test coverage output
coverage/
.nyc_output/
frontend/coverage/
backend/coverage/

# Backup / temp files
*.bak
*.backup
*.orig
*.tmp

# Database dumps. Scoped deliberately: docker/mysql/init/*.sql is tracked
# schema bootstrap and must stay tracked, so this must never become `*.sql`.
/storage-backup-*.sql
/*-backup-*.sql

# Guardian pre-commit scratch project. The validator removes this via
# `trap … EXIT`, which does not fire on SIGKILL or a closed terminal, so a
# killed run can strand it next to tsconfig.app.json where it looks tracked.
frontend/tsconfig.guardian-precommit.json

# Measurement artifacts (EPIC-1 Platform Foundation).
# engineering/baselines/*.jsonl IS tracked — it is the measurement record.
# Traces and probes are regenerable and run to hundreds of MB.
engineering/traces/
frontend/.measurement-probes/
frontend/tsconfig.probe-*.json

# Laravel debug helpers (never commit generated helpers)
backend/_ide_helper_models.php

# Docker runtime state
.docker/

# Scratchpad / one-off scripts (dev-only, never tracked)
backend/*.sh
